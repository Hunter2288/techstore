{
  "Authentication": {
    "Jwt": {
      "Authority": "",
      "Audience": "",
      "RequireHttpsMetadata": true,
      "RequireAuthentication": false
    }
  },
  "ReverseProxy": {
    "Routes": {
      "aggregator": { "ClusterId": "aggregator", "Order": 0, "Match": { "Path": "/api/aggregator/{**catch-all}" } },
      "orders": { "ClusterId": "orders", "Match": { "Path": "/api/orders/{**catch-all}" } },
      "catalog": { "ClusterId": "catalog", "Match": { "Path": "/api/products/{**catch-all}" } },
      "reviews": { "ClusterId": "reviews", "Match": { "Path": "/api/reviews/{**catch-all}" } }
    },
    "Clusters": {
      "aggregator": { "Destinations": { "d1": { "Address": "http://aggregator" } } },
      "orders": { "Destinations": { "d1": { "Address": "http://orders-api" } } },
      "catalog": { "Destinations": { "d1": { "Address": "http://catalog-api" } } },
      "reviews": { "Destinations": { "d1": { "Address": "http://reviews-api" } } }
    }
  }
}
